# Copy this file to .env and replace the API-key placeholder.
OPENAI_API_KEY=replace-with-your-openai-api-key

# OpenAI models used by the RAG pipeline.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini

# Optional: request a shorter embedding from text-embedding-3 models.
# Leave blank to use the model's default dimensions.
OPENAI_EMBEDDING_DIMENSIONS=

# Generation and batching controls.
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_EMBEDDING_BATCH_SIZE=64

# The evaluation notebook makes one model call per question when true.
# Keep false for a cheap retrieval-only/extractive evaluation run.
RAG_EVAL_USE_OPENAI=false

# Optional settings for compatible gateways or organization scoping.
OPENAI_BASE_URL=
OPENAI_ORG_ID=
